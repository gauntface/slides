{
  "name": "@gauntface/slides",
  "description": "A simple HTML slide deck using custom elements",
  "version": "0.2.0",
  "author": "Matt Gaunt",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "build/"
  ],
  "sideEffects": true,
  "module": "./build/gf-slides.js",
  "types": "./build/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/types/index.d.ts",
      "default": "./build/gf-slides.js"
    }
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('build', {recursive: true, force: true})\"",
    "build": "pnpm run clean && pnpm run build:js && pnpm run build:types",
    "build:js": "esbuild src/index.ts --bundle --format=esm --target=es2023 --minify --sourcemap --loader:.css=text --outfile=build/gf-slides.js",
    "build:types": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p src && tsc",
    "test": "pnpm run build && playwright test",
    "server": "pnpm exec esbuild --servedir=. --serve=8888",
    "prepublishOnly": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "keywords": [
    "gf-slides",
    "slides",
    "custom elements"
  ],
  "homepage": "https://github.com/gauntface/slides#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gauntface/slides.git"
  },
  "bugs": {
    "url": "https://github.com/gauntface/slides/issues"
  },
  "packageManager": "pnpm@12.8.1"
}
